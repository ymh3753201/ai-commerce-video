# Default MikuAPI Reference-to-Video route (1-7 generated references).
AI_COMMERCE_VIDEO_MIKUAPI_KEY=
AI_COMMERCE_VIDEO_BASE_URL_GROK_VIDEO_15_REFERENCE=https://mikuapi.org
AI_COMMERCE_VIDEO_MODEL_GROK_VIDEO_15_REFERENCE=grok-imagine-video-1.5
# On macOS, prefer Keychain service: ai-commerce-video-mikuapi-video

# Optional official xAI Reference-to-Video route. Its key is never sent to relays.
XAI_API_KEY=
AI_COMMERCE_VIDEO_BASE_URL_GROK_VIDEO_15_REFERENCE_XAI=https://api.x.ai
AI_COMMERCE_VIDEO_MODEL_GROK_VIDEO_15_REFERENCE_XAI=grok-imagine-video-1.5
# On macOS, prefer Keychain service: ai-commerce-video-xai-video

# Preserved optional MikuAPI single-image route. It reuses the MikuAPI key above.
AI_COMMERCE_VIDEO_BASE_URL_GROK_VIDEO_15=https://mikuapi.org
AI_COMMERCE_VIDEO_MODEL_GROK_VIDEO_15=grok-imagine-video-1.5
# Optional Skill-only proxy. This does not modify Clash or system proxy settings.
AI_COMMERCE_VIDEO_PROXY_URL=

# Optional legacy 119337 route. Never reuse another Provider's credential here.
AI_COMMERCE_VIDEO_119337_KEY=
AI_COMMERCE_VIDEO_BASE_URL_GROK_IMAGE_VIDEO=https://api.119337.xyz/v1
AI_COMMERCE_VIDEO_MODEL_GROK_IMAGE_VIDEO=grok-image-video
# On macOS, prefer Keychain service: ai-commerce-video-119337-video
FAL_KEY=

# Optional: save a private copy at ~/.codex/ai-commerce-video.env
# Do not place a real key inside the skill folder or packaged .skill file.
